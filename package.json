{
  "name": "radiospeak",
  "version": "0.1.0",
  "description": "TeamSpeak 3/6 music bot: YouTube and SoundCloud songs, playlists, saved playlists and radio streams",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "check": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:audio": "node src/test-audio.ts",
    "benchmark:audio": "node scripts/benchmark-audio.mjs",
    "soak:audio": "node scripts/soak-audio.mjs"
  },
  "dependencies": {
    "@honeybbq/teamspeak": "1.0.0-beta.21"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0"
  }
}
