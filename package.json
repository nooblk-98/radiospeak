{
  "name": "radiospeak",
  "version": "0.1.0",
  "description": "TeamSpeak and Discord music bots with shared playlists, search, radio and a web panel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "check": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "test:audio": "node src/audio/test-audio.ts",
    "benchmark:audio": "node scripts/benchmark-audio.mjs",
    "soak:audio": "node scripts/soak-audio.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@honeybbq/teamspeak": "1.0.0-beta.21",
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0"
  }
}
